{
  "manifest_version": 3,
  "name": "国科大在线学习助手",
  "version": "1.7.4",
  "description": "按页面顺序接续视频与 PDF 阅读任务，自动跳过独立习题章节。",
  "permissions": ["storage", "contextMenus", "scripting"],
  "host_permissions": ["https://mooc.mooc.ucas.edu.cn/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "foreground.js" },
  "content_scripts": [
    {
      "matches": [
        "https://mooc.mooc.ucas.edu.cn/mooc2-ans/*",
        "https://mooc.mooc.ucas.edu.cn/mooc-ans/mycourse/*"
      ],
      "js": ["pdf-module.js", "assistant.js"]
    },
    {
      "matches": [
        "https://mooc.mooc.ucas.edu.cn/ananas/modules/pdf/index.html*",
        "https://mooc.mooc.ucas.edu.cn/mooc-ans/screen/file*"
      ],
      "js": ["pdf-module.js"],
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
